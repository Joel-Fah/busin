# Copy to supabase/functions/.env for local Edge Functions (git-ignored). Never commit real values.
# A Mapbox token allowed to use Directions, kept on the server only (docs/guides/bus-route.md, ADR 0017).
MAPBOX_DIRECTIONS_TOKEN=
# Mobile money through pawaPay (ADR 0029, docs/guides/payments-setup.md). The sandbox first; production only with the
# owner's go. Never in an app, the portal or config/*.json.
PAWAPAY_API_TOKEN=
PAWAPAY_BASE_URL=https://api.sandbox.pawapay.io
# The exact address registered as the callback URL in pawaPay's dashboard (pawaPay signs it).
PAWAPAY_CALLBACK_URL=
# "off" only for a sandbox account without signed callbacks; then each callback is checked with pawaPay instead.
PAWAPAY_SIGNED_CALLBACKS=on
# A long random value the payment-checks scheduler sends.
PAYMENTS_RECONCILE_SECRET=

# Public values only. Copy to .env.local and fill in; never commit .env.local.
# For the local backend, run: npx supabase status -o env
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional map settings. All have safe defaults and none is a secret. See docs/decisions/0008-map-provider.md.
# MAP_PROVIDER=maplibre
# MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# MAP_DEFAULT_LAT=3.848
# MAP_DEFAULT_LNG=11.502
# MAP_DEFAULT_ZOOM=12

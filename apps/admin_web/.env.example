# Public values only. Copy to .env.local and fill in; never commit .env.local.
# For the local backend, run: npx supabase status -o env
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional map settings. All have safe defaults and none is a secret. See docs/decisions/0008-map-provider.md.
# MAP_PROVIDER=mapbox   (production uses mapbox when MAPBOX_API_KEY is valid, otherwise maplibre; development and tests use maplibre unless this is set. Mapbox bills per map load.)
# MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# MAP_DEFAULT_LAT=3.848
# MAP_DEFAULT_LNG=11.502
# MAP_DEFAULT_ZOOM=12

# Mapbox public access token (starts with pk., restricted to this site). Never a secret token (sk.).
MAPBOX_API_KEY=

# Landing page download links (server-only, read on each request, none is a secret). Leave empty until a release
# exists: the page then shows "Get notified". Only https addresses are used. See docs/guides/landing.md.
LANDING_ANDROID_URL=
LANDING_PLAY_URL=
LANDING_IOS_URL=

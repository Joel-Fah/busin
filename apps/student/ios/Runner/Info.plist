<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>BusIn reads your approximate location once, when you add your area, so your school can place stops near students. It is rounded to about 500 metres and never tracked.</string>
	<key>NSLocationDefaultAccuracyReduced</key>
	<true/>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>NSCameraUsageDescription</key>
		<string>BusIn uses the camera so you can photograph your payment receipt.</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>BusIn reads the photo you choose as proof of your payment. It cannot see your other photos.</string>
		<!-- Google sign-in: the iOS OAuth client id, and its reversed form as a URL scheme so Google can return to the app.
	     Both are public identifiers, not secrets. The Web client id (the server one) comes from config/dev.json. -->

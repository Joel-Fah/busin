		<string>649952960204-omkmm8ul4ftc2a4kf5i7c8gbhl1e6vqm.apps.googleusercontent.com</string>
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>com.googleusercontent.apps.649952960204-omkmm8ul4ftc2a4kf5i7c8gbhl1e6vqm</string>
				</array>
			</dict>
		</array>
		<key>CFBundleDevelopmentRegion</key>
